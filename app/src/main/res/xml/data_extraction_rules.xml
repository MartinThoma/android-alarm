<?xml version="1.0" encoding="utf-8"?>
<!--
    No cloud backup (requirements NF-04); backups go to a local file instead (GN-05).
    Device-to-device transfer stays on, so alarms move to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
