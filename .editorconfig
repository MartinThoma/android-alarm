root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 140
# Composable functions are PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Packages follow the domain martin-thoma.com, so they contain an underscore (com.martin_thoma).
ktlint_standard_package-name = disabled

[*.{yml,yaml,toml}]
indent_size = 2
